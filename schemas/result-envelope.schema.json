{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Result Envelope",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "task_id",
    "status",
    "executor",
    "evidence"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "executor": {
      "type": "object"
    },
    "changes": {
      "type": "array"
    },
    "tests": {
      "type": "array"
    },
    "verification": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "risks": {
      "type": "array"
    },
    "unresolved": {
      "type": "array"
    },
    "usage": {
      "type": "object"
    },
    "efficiency": {
      "type": "object",
      "description": "Optional Runtime Context v2 efficiency signals (METRICS.md). Balanced with quality/security; never optimized alone.",
      "additionalProperties": false,
      "properties": {
        "standing_context_chars": {
          "type": "integer",
          "minimum": 0
        },
        "context_sources_loaded": {
          "type": "integer",
          "minimum": 0
        },
        "delegated": {
          "type": "boolean"
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "no_progress_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "context_growth_chars": {
          "type": "integer",
          "minimum": 0
        },
        "execution_substrate": {
          "type": "string",
          "enum": ["SELF", "HOWLPLANE", "governed_recovery"]
        },
        "executor_selected": {
          "type": "string"
        },
        "failovers": {
          "type": "integer",
          "minimum": 0
        },
        "persistent_grok_participation": {
          "type": "integer",
          "minimum": 0
        },
        "human_interventions": {
          "type": "integer",
          "minimum": 0
        },
        "accepted": {
          "type": "boolean"
        },
        "plane_repair_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "improvement_work_items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "recommended_next_action": {
      "type": "string"
    },
    "producer_employee_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "accountable_employee_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "contribution_record_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
