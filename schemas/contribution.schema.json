{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contribution Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contribution_id",
    "employee_id",
    "occurred_at",
    "role_at_time",
    "summary",
    "artifact_refs",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "contribution_id": {
      "type": "string"
    },
    "employee_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "role_at_time": {
      "type": "string"
    },
    "work_item_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string"
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified_by": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
