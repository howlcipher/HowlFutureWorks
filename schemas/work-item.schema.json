{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work Item",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "problem",
    "desired_outcome",
    "owner",
    "risk_tier",
    "acceptance_criteria"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "problem": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "desired_outcome": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "priority": {
      "type": "string"
    },
    "risk_tier": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nonfunctional_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    },
    "owner_employee_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
